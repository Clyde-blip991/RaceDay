@model List<RaceDay.Web.Models.ResultInfo>
@{
    ViewData["Title"] = "My results";
}

<h2 class="mb-3">My results</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No results recorded yet. Results appear here after an Organiser records them.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Category</th>
                <th>Finish time</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.EventName</td>
                    <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@r.CategoryName</td>
                    <td>@r.FinishTime</td>
                    <td>@(r.Position.HasValue ? $"{r.Position}" : "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
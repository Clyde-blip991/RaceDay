@model List<RaceDay.Web.Models.EventSummary>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My events</h2>
    <a class="btn btn-success" asp-controller="Organiser" asp-action="Create">+ New event</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Event</th>
                <th>Type</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>@ev.EventType</td>
                    <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
